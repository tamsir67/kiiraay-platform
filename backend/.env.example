# ---------------------------------------------------------------
# KIIRAAY — configuration de l'API (copier en .env, ne JAMAIS committer .env)
# Générer les secrets : npm run keys:generate
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://kiiraay:CHANGER_MOI@localhost:5432/kiiraay
# DB_SSL=true

JWT_SECRET=
DATA_ENCRYPTION_KEY=
DATA_INDEX_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
# Mettre true derrière un reverse proxy (nginx, Caddy) pour la bonne IP client
TRUST_PROXY=false
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
EXPORT_MAX_ROWS=50000
IMPORT_MAX_ROWS=20000
# Mot de passe des comptes de DÉMONSTRATION créés par npm run db:seed
SEED_PASSWORD=Kiiraay@2027!
# Tentatives de connexion par IP / 15 min
LOGIN_RATE_LIMIT=20
